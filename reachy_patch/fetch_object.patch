+"""fetch_object: confirm first, then ask the arm PC over arm.v1 /v1/fetch."""
+from __future__ import annotations
+
+import json
+import threading
+from http.server import BaseHTTPRequestHandler, HTTPServer
+from pathlib import Path
+
+from medicine_buddy.api import MedicineBuddyService
+from medicine_buddy.arm_protocol import FetchCommand, FetchResult
+from medicine_buddy.config import AppConfig
+from medicine_buddy.catalog import MedicineCatalog
+from medicine_buddy.voice_guard import VoiceGuard
+
+
+def _live_service(path, url):
+    catalog = MedicineCatalog({"Aspirin": []})
+    guard = VoiceGuard(catalog, enabled=True, grace=0.)
+    service = MedicineBuddyService(path, AppConfig(dry_run=False, arm_url=url), catalog, guard)
+    service.settings_require_passphrases({"enabled": True})
+    return service
+
+
+def _arm(reply: dict):
+    seen: list[dict] = []
+
+    class H(BaseHTTPRequestHandler):
+        def do_POST(self):  # noqa: N802
+            body = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
+            seen.append({"path": self.path, **body})
+            data = json.dumps({"schema": "medicine_buddy.arm.v1", "message_type": "fetch_result", **reply, "request_id": body["request_id"]}).encode()
+            self.send_response(200)
+            self.send_header("Content-Length", str(len(data)))
+            self.end_headers()
+            self.wfile.write(data)
+
+        def log_message(self, *a):  # noqa: D401
+            pass
+
+    srv = HTTPServer(("127.0.0.1", 0), H)
+    threading.Thread(target=srv.serve_forever, daemon=True).start()
+    return srv, f"http://127.0.0.1:{srv.server_address[1]}", seen
