+def test_client_rejects_cross_request_and_false_physical_claims() -> None:
+    import io
+    from unittest.mock import patch
+    import pytest
+    from medicine_buddy.http_arm import HttpArmClient
+    for kind, dry_run, changes in (("fetch", False, {"request_id": "wrong"}),
+                                  ("fetch", True, {}),
+                                  ("check_taken", False, {"ok": False, "taken": True})):
+        def response(request, **kwargs):
+            body = json.loads(request.data)
+            payload = {"schema": body["schema"], "message_type": body["message_type"] + "_result",
+                       "request_id": body["request_id"], "ok": True, "final_state": "placed",
+                       "place_verified": True, **changes}
+            return io.BytesIO(json.dumps(payload).encode())
+        client = HttpArmClient("http://not-contacted.invalid", dry_run=dry_run)
+        with patch("urllib.request.urlopen", side_effect=response), pytest.raises(RuntimeError):
+            if kind == "fetch":
+                client.fetch(object_name="water bottle")
+            else:
+                client.check_taken(medicine_id=12, medicine_name="Aspirin")
+
