+def test_voice_guard_requires_fresh_yes_for_same_description(tmp_path: Path) -> None:
+    from medicine_buddy.catalog import MedicineCatalog
+    from medicine_buddy.voice_guard import VoiceGuard
+    clock = [100.]
+    catalog = MedicineCatalog({"Aspirin": []})
+    guard = VoiceGuard(catalog, enabled=True, clock=lambda: clock[0], grace=0.)
+    srv, url, seen = _arm({"ok": True, "final_state": "placed", "place_verified": True})
+    service = MedicineBuddyService(tmp_path / "guard.db", AppConfig(dry_run=False, arm_url=url), catalog, guard)
+    service.settings_require_passphrases({"enabled": True})
+    try:
+        name = "small blue water bottle"
+        assert service.fetch_object({"object": name, "confirmed": True})["status"] == "needs_confirm"
+        assert service.fetch_object({"object": name, "confirmed": True})["blocked"]
+        assert not seen
+        clock[0] += 1
+        service.voice_heard({"text": "no"})
+        assert service.fetch_object({"object": name, "confirmed": True})["blocked"]
+        clock[0] += 1
+        service.voice_heard({"text": "yes please"})
+        assert service.fetch_object({"object": name, "confirmed": True})["status"] == "ok"
+        assert seen[0]["object"] == name and len(seen) == 1
+        assert service.fetch_object({"object": name, "confirmed": True})["status"] == "needs_confirm"
+        assert len(seen) == 1
+    finally:
+        service.close()
+        srv.shutdown()
+        srv.server_close()
+
